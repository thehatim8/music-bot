DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=your-lavalink-password
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
YTMUSIC_AUTOPLAY_URL=http://127.0.0.1:3001
# Search providers tried in order. "ytdlp" = YouTube via yt-dlp in the Python service (no
# Lavalink YouTube plugin needed); the rest are Lavalink prefixes.
SEARCH_PROVIDERS=ytdlp,ytmsearch,ytsearch,scsearch
# URL Lavalink uses to pull yt-dlp audio from the Python service. Only needed when Lavalink
# runs on a different machine than the service (then also set YTMUSIC_AUTOPLAY_HOST=0.0.0.0).
# YTDLP_STREAM_URL=http://bot-host-ip:3001
